---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Finicky Bee | Preserving Moments in Time',
	description = 'Finicky Bee explores vintage and antique collectibles through research, documentation, storytelling, and thoughtful preservation.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
                <link rel="apple-touch-icon" href="/finicky-bee-logo.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="author" content="Finicky Bee" />
		<title>{title}</title>
                <meta
	name="description"
	content={description}
/>
<link rel="canonical" href={`https://finickybee.com${Astro.url.pathname}`} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Finicky Bee" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={`https://finickybee.com${Astro.url.pathname}`} />
<meta property="og:image" content="https://finickybee.com/finicky-bee-og-image.png" />
<meta property="og:image:alt" content="Finicky Bee logo" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="https://finickybee.com/finicky-bee-og-image.png" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
