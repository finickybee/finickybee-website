---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import {
  collectibles,
  featuredSettings,
} from '../data/collectibles.js';

const automaticFeatured =
  collectibles.find((collectible) => collectible.featured) ?? collectibles[0];

const manualFeatured =
  collectibles.find(
    (collectible) =>
      collectible.id === featuredSettings.manualCollectibleId
  ) ?? automaticFeatured;

const featuredCollectible =
  featuredSettings.mode === "manual"
    ? manualFeatured
    : automaticFeatured;
---

<Layout
	title="Finicky Bee | Preserving Moments in Time"
	description="Finicky Bee explores vintage and antique collectibles through research, documentation, storytelling, and thoughtful preservation."
>
   <Header />

<main>

    <section class="hero">
  <div class="hero-content">
    <div class="hero-copy">
      <p class="eyebrow">FINICKY BEE</p>

      <h1>Preserving Moments in Time — One Collectible at a Time.</h1>

      <p class="hero-intro">
        Every object has a story.
      </p>

    </div>

    <div class="featured-collectible">
  <a
    href={`/finds/${featuredCollectible.findSlug}`}
    class="featured-image-link"
  >
    <img
      src={featuredCollectible.image}
      alt={featuredCollectible.title}
    />
  </a>

  <div class="featured-caption">
    <p class="featured-label">FEATURED COLLECTIBLE</p>
    <h2>{featuredCollectible.title}</h2>
    <p>{featuredCollectible.shortDescription}</p>
  </div>

  <div class="hero-actions">
    <a
      href={`/finds/${featuredCollectible.findSlug}`}
      class="button primary"
    >
      Explore the Find
    </a>
    <a href="/collection" class="button secondary">
      Explore the Collection
    </a>
  </div>
</div>
  </div>
</section>

    <section class="intro section">
      <div class="narrow">
        <p class="eyebrow">WHAT IS FINICKY BEE?</p>

        <h2>A collector's journey from discovery to preservation.</h2>

        <p>
          Finicky Bee is an independent collecting and research project
          dedicated to discovering meaningful objects from the past and
          documenting the stories behind them.
        </p>

        <p>
          Each find begins with curiosity. Through careful observation,
          research, photography, and documentation, objects become part of
          a growing record of material history.
        </p>
      </div>
    </section>

    <section id="finds" class="feature section">
  <div class="feature-image">
    <a href="/finds" aria-label="Explore Finicky Bee Finds">
      <img
        src="/images/homepage/finds.jpg"
        alt="Antique manual coffee grinder"
      />
    </a>
  </div>

      <div class="feature-content">
        <p class="eyebrow">DOCUMENTARY SERIES</p>

        <h2>Every object has a story.</h2>

        <p>
          Finicky Bee Finds is a documentary series exploring the objects,
          histories, makers, materials, and discoveries behind collectible
          finds.
        </p>

        <p>
          From an unexpected discovery to a carefully researched archive
          record, each episode follows the journey of an object through
          evidence and documentation.
        </p>

       <a href="/finds" class="text-link">
  Discover the stories →
</a>
      </div>
    </section>

    <section class="process section">
      <div class="narrow">
        <p class="eyebrow">FROM FIND TO ARCHIVE</p>

        <h2>A thoughtful process for every discovery.</h2>
      </div>

      <div class="process-grid">
        <article>
          <span>01</span>
          <h3>Discover</h3>
          <p>Find objects with potential historical, cultural, or collecting interest.</p>
        </article>

        <article>
          <span>02</span>
          <h3>Research</h3>
          <p>Examine evidence, marks, materials, construction, and documented history.</p>
        </article>

        <article>
          <span>03</span>
          <h3>Document</h3>
          <p>Record observations, research findings, photographs, and supporting details.</p>
        </article>

        <article>
          <span>04</span>
          <h3>Preserve</h3>
          <p>Create a lasting record that helps keep the object's story connected to it.</p>
        </article>

        <article>
          <span>05</span>
          <h3>Share</h3>
          <p>Tell the story through collections, research, documentaries, and educational content.</p>
        </article>
      </div>
    </section>

        <section id="collection" class="collection section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">COLLECTION / ARCHIVE</p>
          <h2>A growing archive of collected objects.</h2>
        </div>
      </div>

      <div class="collection-grid">
        <article class="collection-card">
          <a href="/collection" class="collection-image-link">
            <img
              src="/images/homepage/collection.jpg"
              alt="Collection of decorative illustrated plates displayed with books and a flower"
            />
          </a>

          <div class="card-content">
            <p class="archive-number">SELECTED FROM THE ARCHIVE</p>
            <h3>Decorative Plate Collection</h3>
            <p>A collection of illustrated plates preserved as part of the archive.</p>

            <a href="/collection" class="text-link">
              View the archive →
            </a>
          </div>
        </article>
      </div>
    </section>
    <section id="research" class="research section">
  <div class="research-image">
    <a href="/research" aria-label="Explore Finicky Bee research">
      <img
       src="/images/homepage/research.png"
        alt="Research study of a ceramic sculpture with magnified maker markings"
      />
    </a>
  </div>

  <div class="research-content">
        <p class="eyebrow">RESEARCH & STORIES</p>

        <h2>Look closer. Follow the evidence.</h2>

        <p>
          Finicky Bee research focuses on identifying objects responsibly,
          documenting physical observations, studying makers and materials,
          and separating established information from uncertainty.
        </p>

        <p>
          The goal is not simply to identify an object. It is to understand
          what can be supported by evidence and preserve that knowledge for
          future reference.
        </p>

                <a href="/research" class="button button-secondary">
          Read the Research
        </a>
      </div>
    </section>

    <section class="mission section">
      <div class="narrow">
        <p class="eyebrow">SUPPORT THE MISSION</p>

        <h2>Preservation is sustained by meaningful work.</h2>

        <p>
          Finicky Bee is an independent business. Collectibles may be offered
          for sale through selected marketplaces and other channels.
        </p>

        <p>
          Purchases help sustain the time, research, documentation,
photography, preservation, and storytelling that make the
Finicky Bee mission possible.
        </p>
      </div>
    </section>

    <section class="where-to-find section">
      <div class="narrow">
        <p class="eyebrow">WHERE TO FIND FINICKY BEE</p>

        <h2>Follow the collection wherever it travels.</h2>

        <p>
          Finicky Bee collectibles and stories may appear across several
          marketplaces and platforms.
        </p>

        <div class="platform-list">
  <a
    href="https://www.ebay.com/str/finickybee"
    target="_blank"
    rel="noopener noreferrer"
  >
    eBay
  </a>

  <a
    href="https://www.etsy.com/shop/FinickyBee"
    target="_blank"
    rel="noopener noreferrer"
  >
    Etsy
  </a>
</div>
      </div>
    </section>

    <section id="about" class="about section">
      <div class="about-content">
        <p class="eyebrow">ABOUT THE FOUNDER</p>

        <h2>A collector, researcher, and entrepreneur preserving stories through objects.</h2>

        <p>
          Finicky Bee was created as an independent collecting and research
          project with a simple belief: ordinary-looking objects can carry
          extraordinary stories.
        </p>

        <p>
          The work combines collecting, research, documentation,
          entrepreneurship, and storytelling while keeping authenticity,
          transparency, and responsible research at the center.
        </p>
       <a href="https://www.linkedin.com/in/daisybox/" class="text-link" target="_blank" rel="noopener noreferrer">
  View the Founder’s Professional Profile →
</a>
      </div>
    </section>

    <footer class="site-footer">
      <div>
        <p class="footer-brand">FINICKY BEE</p>
        <p>Preserving Moments in Time — One Collectible at a Time.</p>
      </div>

      <div class="footer-links">
  <a href="/about">About</a>
  <a href="/finds">Finicky Bee Finds</a>
  <a href="/collection">Collection</a>
  <a href="/research">Research</a>
  <a href="/shop">Shop</a>
  <a href="/contact">Contact</a>
  <a href="/privacy">Privacy</a>
  <a href="/terms">Terms</a>
</div>

      <p class="copyright">
        © {new Date().getFullYear()} Finicky Bee. All rights reserved.
      </p>
    </footer>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f3e9;
    color: #302f2a;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(a) {
    color: inherit;
  }

  .site-header {
    background: #f7f3e9;
    border-bottom: 1px solid #ddd6c7;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand {
    color: #2f4f3f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 24px;
    font-size: 0.9rem;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover,
  .text-link:hover {
    color: #a77c16;
  }

       .hero {
    background: #2f4f3f;
    color: #fffaf0;
  }

  .hero-content {
    width: min(1200px, calc(100% - 56px));
    min-height: 520px;
    margin: 0 auto;
    padding: 60px 0;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: 60px;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero h1 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(3rem, 5.5vw, 5.5rem);
    line-height: 0.98;
  }

  .hero-intro {
    margin: 28px 0 30px;
    font-size: 1.1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero .button {
    display: inline-block;
    padding: 14px 21px;
    border: 1px solid #d4a437;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .hero .button.primary {
    background: #d4a437;
    color: #2f342d;
  }

  .hero .button.secondary {
    background: transparent;
    color: #fffaf0;
    border-color: #fffaf0;
  }

    .featured-collectible {
  width: 100%;
  max-width: 420px;
  justify-self: end;
}

  .featured-image-link {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.featured-image-link img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}
    object-fit: cover;
    object-position: center center;
  }

  .featured-caption {
    padding-top: 18px;
  }

  .featured-label {
    margin: 0 0 8px;
    color: #e4c36b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .featured-caption h2 {
    margin: 0 0 4px;
    color: #fffaf0;
    font-size: 1.5rem;
  }

  .featured-caption p:last-child {
    margin: 0;
    color: #f7f3e9;
    font-size: 0.95rem;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #a77c16;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .hero .eyebrow {
    color: #e4c36b;
  }

  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.98;
  }

  h2 {
    margin: 0 0 25px;
    color: #2f4f3f;
    font-size: clamp(2.1rem, 4vw, 4rem);
    line-height: 1.05;
  }

  h3 {
    margin: 8px 0;
    font-size: 1.5rem;
  }

  p {
    line-height: 1.75;
  }

  .hero-text {
    max-width: 680px;
    margin: 32px 0;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    display: inline-block;
    padding: 14px 21px;
    border: 1px solid #d4a437;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .button-primary {
    background: #d4a437;
    color: #2f342d;
  }

  .button-secondary {
    background: transparent;
    color: #2f4f3f;
  }

  .hero .button-secondary {
    color: #fffaf0;
    border-color: #fffaf0;
  }

  .section {
    padding: 110px 28px;
  }

  .narrow {
    max-width: 850px;
    margin: 0 auto;
  }

  .intro {
    text-align: center;
  }

  .intro p,
  .mission p,
  .where-to-find p {
    font-size: 1.08rem;
  }

  .feature {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .feature-image {
    width: 100%;
  }

  .feature-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .image-placeholder {
    height: 100%;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #d8d2c3;
    color: #2f4f3f;
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0.12em;
  }

  .feature-content {
    max-width: 520px;
  }

  .feature-content p {
    font-size: 1.05rem;
  }

  .text-link {
    display: inline-block;
    margin-top: 15px;
    color: #2f4f3f;
    font-weight: 700;
    text-decoration: none;
  }

  .process {
    background: #e8ebe4;
  }

  .process-grid {
    max-width: 1200px;
    margin: 60px auto 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 25px;
  }

  .process-grid article {
    border-top: 1px solid #9da89d;
    padding-top: 20px;
  }

  .process-grid span {
    color: #a77c16;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .process-grid p {
    font-size: 0.92rem;
  }

  .section-heading {
    max-width: 1200px;
    margin: 0 auto 50px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
  }

    .collection-grid {
    max-width: 1200px;
    margin: 0 auto;
  }

  .collection-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 55px;
    align-items: center;
  }

  .collection-image-link {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .collection-image-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-placeholder {
    height: 330px;
    background: #d8d2c3;
  }

  .card-content {
    padding: 25px;
  }

  .archive-number {
    margin: 0;
    color: #a77c16;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .card-content p:last-child {
    margin-bottom: 0;
  }

  .research {
  background: #2f4f3f;
  color: #f7f3e9;
}

.research-image {
  max-width: 1200px;
  margin: 0 auto 60px;
}

.research-image a {
  display: block;
}

.research-image img {
  display: block;
  width: 100%;
  max-height: 520px;
  object-fit: cover;
  object-position: center;
}

.research-content {
    max-width: 850px;
    margin: 0 auto;
  }

  .research h2 {
    color: #fffaf0;
  }

  .research p {
    font-size: 1.08rem;
  }

  .research .button-secondary {
    margin-top: 20px;
    color: #fffaf0;
    border-color: #d4a437;
  }

  .mission {
    text-align: center;
  }

  .where-to-find {
    background: #e8ebe4;
    text-align: center;
  }

  .platform-list {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 35px;
  }

  .platform-list span {
    display: inline-block;
    min-width: 90px;
    padding: 13px 22px;
    border: 1px solid #2f4f3f;
    background: #f7f3e9;
    color: #2f4f3f;
    font-weight: 600;
    text-align: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .platform-list span:hover {
    background: #2f4f3f;
    color: #fffaf0;
  }

  .about {
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-content {
    max-width: 750px;
  }

  .site-footer {
    padding: 60px 28px;
    background: #243c30;
    color: #f7f3e9;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
  }

  .footer-brand {
    margin: 0 0 10px;
    color: #e4c36b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    letter-spacing: 0.14em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    text-decoration: none;
  }

  .copyright {
    grid-column: 1 / -1;
    margin: 20px 0 0;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.8rem;
  }
   
  @media (max-width: 700px) {
      .hero {
      min-height: auto;
    }

    .hero-content {
      width: min(100% - 44px, 700px);
      min-height: auto;
      padding: 60px 0 70px;
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .featured-collectible {
      max-width: none;
      justify-self: stretch;
    }

    .section {
      padding: 80px 22px;
    }

    .feature {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .process-grid {
      grid-template-columns: 1fr 1fr;
    }

    .collection-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer {
      grid-template-columns: 1fr;
    }

    .copyright {
      grid-column: auto;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: 3rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      text-align: center;
    }

    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>