---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="Contact | Finicky Bee"
  description="Contact Finicky Bee for general business, website, research-content, and other appropriate inquiries."
>
  <Header />

 <main class="contact-page">
  <section class="contact-content">
    <h1>Contact Finicky Bee</h1>

    <p>
      For general business, website, or other appropriate inquiries, please
      email:
    </p>

    <p>
      <strong>
        <a href="mailto:info@finickybee.com">info@finickybee.com</a>
      </strong>
    </p>

    <h2>Marketplace orders and transactions</h2>

    <p>
      Please use the communication tools provided by the marketplace where
      the transaction was made. Finicky Bee does not handle marketplace
      order communication through this website.
    </p>
  </section>
</main>

<footer class="site-footer">
  <div>
    <p class="footer-brand">FINICKY BEE</p>
    <p>Preserving Moments in Time — One Collectible at a Time.</p>
  </div>

  <div class="footer-links">
    <a href="/about">About</a>
    <a href="/finds">Finicky Bee Finds</a>
    <a href="/collection">Collection</a>
    <a href="/research">Research</a>
    <a href="/shop">Shop</a>
    <a href="/contact">Contact</a>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
  </div>

  <p class="copyright">
    © {new Date().getFullYear()} Finicky Bee. All rights reserved.
  </p>
</footer>

  <style>
    .contact-page {
  width: 100%;
  margin: 0;
  padding: 72px 28px 100px;
  background: #f7f3ea;
  box-sizing: border-box;
}

    .contact-content {
      max-width: 700px;
      margin: 0 auto;
    }

    h1 {
      margin-bottom: 28px;
      color: #2f4f3f;
    }

    h2 {
      margin-top: 48px;
      margin-bottom: 16px;
      color: #2f4f3f;
    }

    p {
      line-height: 1.7;
      margin-bottom: 18px;
    }

    a {
      color: #2f4f3f;
    }

    a:hover {
  color: #a77c16;
}

.site-footer {
  background: #2f4f3f;
  color: #f7f3ea;
  padding: 55px 24px;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 40px;
}

.site-footer p {
  margin: 0 0 8px;
}

.footer-brand {
  color: #d4a437;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px 22px;
}

.footer-links a {
  color: #f7f3ea;
}

.copyright {
  grid-column: 1 / -1;
  padding-top: 25px;
  border-top: 1px solid rgba(247, 243, 234, 0.2);
  font-size: 0.85rem;
}

@media (max-width: 700px) {
  .site-footer {
    grid-template-columns: 1fr;
  }

  .copyright {
    grid-column: auto;
  }
}

@media (max-width: 560px) {
      .contact-page {
        padding: 48px 20px 72px;
      }
    }
  </style>
</Layout>