---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { collectibles } from "../../data/collectibles.js";

export function getStaticPaths() {
  return collectibles.map((collectible) => ({
    params: { slug: collectible.findSlug },
    props: { collectible },
  }));
}

const { collectible } = Astro.props;

const photos = [
  {
    src: "/images/finds/vintage-iron/01-hero.jpg",
    alt: "Front side view of the vintage cast iron charcoal box iron",
  },
  {
    src: "/images/finds/vintage-iron/02-alternate.jpg",
    alt: "Alternate view of the vintage cast iron charcoal box iron",
  },
  {
    src: "/images/finds/vintage-iron/03-rooster-catch.jpg",
    alt: "Figural rooster catch on the vintage cast iron charcoal box iron",
  },
  {
    src: "/images/finds/vintage-iron/04-interior.jpg",
    alt: "Interior charcoal chamber of the vintage cast iron box iron",
  },
  {
    src: "/images/finds/vintage-iron/05-handle.jpg",
    alt: "Turned hardwood handle and cast iron handle support",
  },
  {
    src: "/images/finds/vintage-iron/06-soleplate.jpg",
    alt: "Soleplate of the vintage cast iron box iron",
  },
];
---

<Layout
  title={`${collectible.title} | Finicky Bee Finds`}
  description={`${collectible.shortDescription} Explore its Finicky Bee Finds story and documentation.`}
>
  <main>
    <Header />

    <section class="story-hero">
      <div class="story-hero-inner">
        <div class="story-hero-image">
         <img
  src={photos[0].src}
  alt={photos[0].alt}
/>
        </div>

        <div class="story-content">
          <p class="eyebrow">
  FINICKY BEE FINDS · {collectible.documentaryNumber} · {collectible.archiveNumber}
</p>

          <h1>{collectible.title}</h1>

          <p class="editorial-title">{collectible.editorialTitle}</p>
        </div>
      </div>
    </section>

    <section class="story-section">
  <div class="story-layout">
   <div class="story-image">
  <img
    src={photos[3].src}
    alt={photos[3].alt}
  />
</div>

    <div class="story-text">
      <p class="eyebrow">THE STORY</p>

      <h2>A charcoal box iron built to carry its own heat.</h2>

      <p>
        Before electric irons became commonplace, charcoal irons allowed heat
        to travel with the object. This example has a hollow cast-iron body,
        a hinged ventilated lid, and a figural rooster catch.
      </p>

      <p>
        The rooster serves both as ornament and as the mechanism that holds
        the lid closed.
      </p>

      <p>
        This Finicky Bee Finds entry documents the object as received, with
        its observable construction, condition, and distinctive details
        preserved as part of the archive.
      </p>
    </div>
  </div>
</section>
<section class="story-section documentary-section">
  <div class="narrow">
    <p class="eyebrow">THE DOCUMENTARY</p>

    <h2>Watch the story of the object.</h2>

    <p>
      Follow FB-00017 as this charcoal box iron is examined, documented,
      and preserved through the Finicky Bee Finds series.
    </p>

    <a
      href="https://youtu.be/uSRMLEcfQ5M"
      class="text-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      Watch the Finicky Bee documentary →
    </a>
  </div>
</section>
    <section class="story-section photo-record">
      <div class="narrow">
        <p class="eyebrow">PHOTOGRAPHIC RECORD</p>

        <h2>Observed details of the object.</h2>

        <div class="photo-grid">
         {
  photos.slice(1, 3).map((photo) => (
    <figure>
      <img src={photo.src} alt={photo.alt} />
    </figure>
  ))
}

{
  photos.slice(4).map((photo) => (
    <figure>
      <img src={photo.src} alt={photo.alt} />
    </figure>
  ))
}
        </div>
      </div>
    </section>

    <section class="story-section story-note">
      <div class="narrow">
        <p class="eyebrow">DOCUMENTATION</p>

        <h2>From discovery to archive.</h2>

        <p>
          The Finicky Bee Finds series follows objects through discovery,
          research, documentation, and preservation.
        </p>

        <a href="/finds" class="text-link">
          Back to Finicky Bee Finds →
        </a>
      </div>
    </section>

    <footer class="site-footer">
      <div>
        <p class="footer-brand">FINICKY BEE</p>
        <p>Preserving Moments in Time — One Collectible at a Time.</p>
      </div>

      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/finds">Finicky Bee Finds</a>
        <a href="/collection">Collection</a>
        <a href="/research">Research</a>
        <a href="/shop">Shop</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>

      <p class="copyright">
        © {new Date().getFullYear()} Finicky Bee. All rights reserved.
      </p>
    </footer>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #f7f3e9;
    color: #302f2a;
    font-family: Arial, Helvetica, sans-serif;
  }

  .story-hero {
    padding: 80px 28px;
    background: #2f4f3f;
    color: #fffaf0;
  }

  .story-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 70px;
    align-items: center;
  }

  .story-hero-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .story-content {
    max-width: 620px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #d4a437;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    line-height: 1.1;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  h2 {
    margin: 0 0 28px;
    color: #2f4f3f;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  p {
    line-height: 1.8;
  }

  .editorial-title {
    margin: 24px 0 0;
    color: #e4c36b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-style: italic;
  }

  .story-section {
    padding: 100px 28px;
  }

  .story-layout {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 70px;
    align-items: center;
  }

  .story-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .story-text {
    max-width: 600px;
  }
.documentary-section {
  background: #f7f3e9;
}
  .story-note {
    background: #e8ebe4;
  }

  .narrow {
    max-width: 800px;
    margin: 0 auto;
  }

  .photo-grid {
    margin-top: 50px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .photo-grid figure {
    margin: 0;
  }

  .photo-grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    color: #2f4f3f;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link:hover {
    color: #a77c16;
  }

  .site-footer {
    padding: 60px 28px;
    background: #243c30;
    color: #f7f3e9;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
  }

  .footer-brand {
    margin: 0 0 10px;
    color: #e4c36b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    letter-spacing: 0.14em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #f7f3e9;
    text-decoration: none;
  }

  .copyright {
    grid-column: 1 / -1;
    margin: 20px 0 0;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .story-hero {
      padding: 70px 22px;
    }

    .story-hero-inner {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.story-content {
  order: 1;
}

.story-hero-image {
  order: 2;
  width: 100%;
}

    .story-section {
      padding: 70px 22px;
    }

    .photo-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .story-layout {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .site-footer {
      grid-template-columns: 1fr;
    }

    .copyright {
      grid-column: auto;
    }
  }
</style>